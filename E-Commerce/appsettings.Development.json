{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=Ecommerce;Username=postgres;Password=<set via user-secrets>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "<set via user-secrets>",
    "Issuer": "EcommerceApi",
    "Audience": "EcommerceApiUsers",
    "ExpiresInMinutes": 60
  }
}
