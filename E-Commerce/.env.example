# Copy this file to ".env" (same folder) and replace every CHANGE_ME.
#   cp .env.example .env
# .env is git-ignored. Never commit real values. The app refuses to start while any
# value still contains CHANGE_ME.
#
# Notes:
# - A double underscore is a colon in the app's configuration (Jwt__Key = Jwt:Key).
# - ${NAME} is replaced with the value of NAME defined above.
# - Use letters and numbers only in passwords (; and , break connection strings).
# - A real environment variable with the same name always wins over this file.

# --- Docker (read by docker compose) ---
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- App connections (reuse the passwords above) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=Ecommerce;Username=postgres;Password=${POSTGRES_PASSWORD}
ConnectionStrings__Redis=localhost:6379,password=${REDIS_PASSWORD},ssl=false,abortConnect=false

# --- JWT signing key: at least 32 characters. Generate one with: openssl rand -base64 32
Jwt__Key=CHANGE_ME

# --- First admin account, created at the first startup if it does not exist ---
Admin__Email=admin@example.com
Admin__Password=CHANGE_ME
Admin__Name="System Admin"
